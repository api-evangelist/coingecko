                "simple",
                "price"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of CoinGecko coin IDs (e.g., bitcoin,ethereum)"
                },
                {
                  "disabled": false,
                  "key": "vs_currencies",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of target currencies (e.g., usd,eur,btc)"
