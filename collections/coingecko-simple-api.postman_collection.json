          "name": "Get coin price by IDs",
          "request": {
            "name": "Get coin price by IDs",
            "description": {
              "content": "Query the prices of one or more coins by using their unique CoinGecko coin IDs. Optionally include market cap, 24h volume, 24h change, and last updated timestamp.",
              "type": "text/plain"
            },
            "url": {
