{
  "opencollection": "1.0.0",
  "info": {
    "name": "CoinGecko Crypto Market Data Asset Platforms Exchange Rates API",
    "version": "3.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-cg-demo-api-key",
      "value": "{{x-cg-demo-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Exchange Rates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get BTC exchange rates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coingecko.com/api/v3/exchange_rates"
          },
          "docs": "Get the current exchange rates for BTC against all supported currencies. Includes fiat currencies, cryptocurrencies, and precious metals."
        }
      ]
    }
  ],
  "bundled": true
}