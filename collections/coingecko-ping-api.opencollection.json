{
  "opencollection": "1.0.0",
  "info": {
    "name": "CoinGecko Crypto Market Data Asset Platforms Ping API",
    "version": "3.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-cg-demo-api-key",
      "value": "{{x-cg-demo-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ping",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check API server status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coingecko.com/api/v3/ping"
          },
          "docs": "Check the API server status. Returns a gecko_says message to confirm the server is operational."
        }
      ]
    }
  ],
  "bundled": true
}