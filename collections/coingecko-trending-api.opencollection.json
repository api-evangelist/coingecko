{
  "opencollection": "1.0.0",
  "info": {
    "name": "CoinGecko Crypto Market Data Asset Platforms Trending API",
    "version": "3.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-cg-demo-api-key",
      "value": "{{x-cg-demo-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Trending",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get trending search list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coingecko.com/api/v3/search/trending"
          },
          "docs": "Get the top trending coins, NFTs, and categories on CoinGecko based on search activity in the last 24 hours. Includes the top 7 trending coins with market data."
        }
      ]
    }
  ],
  "bundled": true
}