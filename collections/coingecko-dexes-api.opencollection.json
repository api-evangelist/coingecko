{
  "opencollection": "1.0.0",
  "info": {
    "name": "CoinGecko Crypto Market Data Asset Platforms DEXes API",
    "version": "3.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-cg-demo-api-key",
      "value": "{{x-cg-demo-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "DEXes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List DEXes on a network",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coingecko.com/api/v3/onchain/networks/:network/dexes",
            "params": [
              {
                "name": "network",
                "value": "",
                "type": "path",
                "description": "The blockchain network identifier (e.g., eth, bsc, polygon_pos, solana, arbitrum, avalanche, base)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              }
            ]
          },
          "docs": "Get the list of all supported decentralized exchanges on a specific blockchain network."
        }
      ]
    }
  ],
  "bundled": true
}