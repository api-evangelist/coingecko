        {
          "id": "cd5ffa61-ec58-47e5-9ec0-7079c4bdba1a",
          "name": "Get pool OHLCV chart data",
          "request": {
            "name": "Get pool OHLCV chart data",
            "description": {
              "content": "Get OHLCV (Open, High, Low, Close, Volume) candlestick chart data for a specific liquidity pool. Supports daily, hourly, and minutely timeframes with various aggregation periods.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "onchain",
                "networks",
                ":network",
                "pools",
                ":pool_address",
                "ohlcv",
                ":timeframe"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "aggregate",
                  "value": "<integer>",
                  "description": "Aggregation period. For day timeframe (1). For hour timeframe (1, 4, 12). For minute timeframe (1, 5, 15)."
                },
                {
                  "disabled": false,
                  "key": "before_timestamp",
                  "value": "<integer>",
                  "description": "Return data before this UNIX timestamp"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Number of OHLCV data points to return (max 1000)"
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "usd",
                  "description": "Price currency (usd or token)"
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "Which token to use for price (base or quote). Only applicable when currency is token."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "network",
                  "description": "(Required) The blockchain network identifier (e.g., eth, bsc, polygon_pos, solana, arbitrum, avalanche, base)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "pool_address",
                  "description": "(Required) The pool contract address"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "timeframe",
                  "description": "(Required) OHLCV timeframe granularity"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
