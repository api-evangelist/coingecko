{
  "opencollection": "1.0.0",
  "info": {
    "name": "CoinGecko Crypto Market Data Asset Platforms API",
    "version": "3.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-cg-demo-api-key",
      "value": "{{x-cg-demo-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Asset Platforms",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List asset platforms",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coingecko.com/api/v3/asset_platforms",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter by platform type (e.g., nft to get NFT-supported platforms)"
              }
            ]
          },
          "docs": "Get the list of all asset platforms (blockchains) supported by CoinGecko. Each platform includes its chain identifier and native coin ID."
        }
      ]
    }
  ],
  "bundled": true
}