          "request": {
            "name": "Get recent trades for a pool",
            "description": {
              "content": "Get the most recent trades for a specific liquidity pool on a given network. Returns trade details including price, volume, and transaction hashes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "onchain",
                "networks",
                ":network",
                "pools",
                ":pool_address",
                "trades"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "trade_volume_in_usd_greater_than",
                  "value": "<number>",
                  "description": "Filter trades by minimum USD volume"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "network",
                  "description": "(Required) The blockchain network identifier (e.g., eth, bsc, polygon_pos, solana, arbitrum, avalanche, base)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "pool_address",
                  "description": "(Required) The pool contract address"
                }
              ]
